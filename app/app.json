{
  "expo": {
    "name": "Expresser",
    "slug": "expresser",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fbf7f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.mushroomdao.expresser",
      "infoPlist": {
        "NSCameraUsageDescription": "Expresser 需要访问相机以拍照和录像,作为日常内容池的一部分。",
        "NSMicrophoneUsageDescription": "Expresser 需要访问麦克风以录入语音片段并本地转写。",
        "NSPhotoLibraryAddUsageDescription": "保存拍摄的照片或视频到你的相册。",
        "NSSpeechRecognitionUsageDescription": "需要语音识别权限，将你的录音转为文字。"
      }
    },
    "android": {
      "package": "org.mushroomdao.expresser",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fbf7f1"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Expresser 需要访问相机以拍照和录像。",
          "microphonePermission": "Expresser 需要访问麦克风以录入语音片段。",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Expresser 需要访问麦克风以录入语音片段。"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6db840ea-81d8-470b-8ebb-f1691dc34598"
      }
    }
  }
}
