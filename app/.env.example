# Expresser runtime configuration. Copy to `.env` and fill in.
#
# `EXPO_PUBLIC_*` variables are inlined into the JS bundle at build time —
# safe for endpoint URLs, NOT for secrets.

# Switch between mock pipeline and live HTTP backend.
# Values: mock | live
EXPO_PUBLIC_API_MODE=mock

# When EXPO_PUBLIC_API_MODE=live, point these at your NAS / RSS bridge.
# Both endpoints expect:
#   POST {URL}/upload   body=DraftPayload  → 200 ok
#   POST {URL}/publish  body=DraftPayload  → 200 { targets: TargetId[] }
EXPO_PUBLIC_NAS_URL=http://nas.local:7080
EXPO_PUBLIC_RSS_URL=http://nas.local:7081
